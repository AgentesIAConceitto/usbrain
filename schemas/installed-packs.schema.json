{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usbrain.org/schemas/installed-packs.schema.json",
  "title": "USBRAIN Installed Packs Descriptor",
  "description": "Descriptor listing packs installed by the Builder and available to the Runtime.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "packs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/installedPack"
      },
      "minItems": 0
    }
  },
  "$defs": {
    "languageCode": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.)[^\\0]+$",
      "minLength": 1
    },
    "dependencyId": {
      "type": "string",
      "minLength": 1
    },
    "installedPack": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "installed_pack_id",
        "pack_id",
        "name",
        "version",
        "pack_type",
        "relative_manifest_path",
        "relative_root_path",
        "languages",
        "category",
        "activation_mode",
        "dependencies",
        "sensitivity_level"
      ],
      "properties": {
        "installed_pack_id": {
          "type": "string",
          "minLength": 1
        },
        "pack_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "pack_type": {
          "type": "string",
          "enum": [
            "knowledge",
            "behavior",
            "tool",
            "hybrid"
          ]
        },
        "relative_manifest_path": {
          "$ref": "#/$defs/relativePath"
        },
        "relative_root_path": {
          "$ref": "#/$defs/relativePath"
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/languageCode"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "activation_mode": {
          "type": "string",
          "enum": [
            "always",
            "language-matched",
            "on-demand",
            "policy-controlled"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependencyId"
          },
          "uniqueItems": true
        },
        "sensitivity_level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    }
  }
}
