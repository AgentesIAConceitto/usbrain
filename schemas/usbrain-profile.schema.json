{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usbrain.org/schemas/usbrain-profile.schema.json",
  "title": "USBRAIN Profile",
  "description": "Identity and high-level intent profile for a generated USBRAIN instance.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "profile_id",
    "name",
    "primary_language",
    "supported_languages",
    "mode",
    "privacy_mode",
    "gpu_preference",
    "personality_profile",
    "agent_profile"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "primary_language": {
      "$ref": "#/$defs/languageCode"
    },
    "supported_languages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/languageCode"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "mode": {
      "type": "string",
      "enum": [
        "offline",
        "local-assisted",
        "hybrid"
      ]
    },
    "privacy_mode": {
      "type": "string",
      "enum": [
        "strict-local",
        "local-first",
        "hybrid-explicit"
      ]
    },
    "gpu_preference": {
      "type": "string",
      "enum": [
        "disabled",
        "optional",
        "preferred"
      ]
    },
    "personality_profile": {
      "$ref": "#/$defs/profileRef"
    },
    "agent_profile": {
      "$ref": "#/$defs/profileRef"
    },
    "description": {
      "type": "string"
    },
    "default_pack_collection": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "owner_label": {
      "type": "string"
    }
  },
  "$defs": {
    "languageCode": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "profileRef": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "enum": [
                "builtin",
                "pack",
                "custom"
              ]
            }
          }
        }
      ]
    }
  }
}
